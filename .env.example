# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cursor48

# Better Auth — use a long random string in production (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here
# Base URL of this app (same origin as the browser uses)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails allowed to sign up as super admin (admin login)
SUPER_ADMIN_EMAILS=admin@example.com

# Optional: OAuth (leave unset to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend) — REQUIRED in production: participants sign in with a 6-digit code
# emailed to their Luma registration address. Without a key, production sign-in fails
# with "could not send the code"; in `next dev` the code is printed in the server log.
RESEND_API_KEY=
# From address on a domain verified in Resend (e.g. "Grok Hackathon <portal@your-domain>")
EMAIL_FROM=

# Luma API (read-only): live guest check at sign-in + "Sync from Luma" on /admin/dashboard/luma.
# LUMA_API_KEY is a secret: set it in the deployment environment only, never commit it. Without it the portal
# uses the guest list imported from CSV only. LUMA_EVENT_API_ID defaults to EVENT.registration.lumaEventId.
LUMA_API_KEY=
LUMA_EVENT_API_ID=evt-IEb2nHBuHyLU7Jz

# Canonical public URL for SEO, sitemap, JSON-LD (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker / startup: migrations before server (see scripts/start-with-migrate.mjs)
DB_MIGRATION_ATTEMPTS=20
DB_MIGRATION_DELAY_MS=3000

# Optional: public contact shown on the site (if wired in UI)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
